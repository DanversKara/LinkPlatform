# =====================================================================
# LinkPlatform v12 — configuration. NEVER commit this file with real secrets.
# Generated by linkplatform-v12-install.sh on first install.
# =====================================================================

# --- Site -----------------------------------------------------------------
SITE_NAME=LinkPlatform
SITE_TAGLINE=Short links, beautifully simple
# Host port the app listens on (container always uses 8000 internally).
APP_PORT=8000
# Bind address for the app's published port. When a domain is configured the
# installer sets this to 127.0.0.1 so all public traffic goes through Caddy
# (which sets X-Forwarded-For truthfully); direct access can't spoof IPs.
APP_BIND=0.0.0.0

# --- Public access --------------------------------------------------------
# Leave DOMAIN empty for local/LAN-only mode (no TLS proxy is started).
DOMAIN=
# Public base URL used when generating short links, e.g. https://links.example.com
BASE_URL=

# --- Security -------------------------------------------------------------
# Randomly generated on first install. Changing it invalidates all sessions.
SECRET_KEY=
# Comma-separated hosts allowed to serve the app. Installer pre-fills
# localhost, 127.0.0.1, your LAN IPs, and DOMAIN.
ALLOWED_HOSTS=localhost,127.0.0.1
# Trust X-Forwarded-For only from private/loopback peers. Set true when
# running behind Caddy (the installer does this automatically with a domain).
TRUST_PROXY=false
# Secure cookie flag: auto = enabled when BASE_URL starts with https://
SECURE_COOKIES=auto

# --- Admin bootstrap ------------------------------------------------------
# Used ONLY on first boot to create the admin account. Change the password
# inside the app afterwards; these values are then ignored.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Registration ---------------------------------------------------------
REGISTRATION_OPEN=true

# --- Mail (optional — password resets) ------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# --- Housekeeping ---------------------------------------------------------
# Click records older than this many days are pruned nightly. 0 = keep forever.
CLICK_RETENTION_DAYS=90
